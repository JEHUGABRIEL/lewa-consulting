# Copiez ce fichier vers `.env.local` et adaptez les valeurs.

# ---- Identifiants de la zone d'administration (/admin) ----
# En production, changez impérativement ces valeurs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Secret de signature des sessions admin ----
# Obligatoire en production (les sessions échouent s'il est absent).
# Génération :  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---- Supabase (PostgreSQL) — stockage du contenu admin ----
# https://supabase.com/dashboard/project/_/settings/api
# La clé secrète ne doit JAMAIS être exposée côté client.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://votre-projet.supabase.co/auth/v1/.well-known/jwks.json

# ---- Resend (emails d'invitation admin + code OTP) ----
# Clé API : https://resend.com/api-keys
# Sans clé (dev), les emails ne sont PAS envoyés : le lien d'invitation et le
# code OTP s'affichent à l'écran et dans les logs serveur pour tester le flux.
RESEND_API_KEY=
# Expéditeur : domaine vérifié sur Resend (sinon onboarding@resend.dev en test)
ADMIN_INVITE_FROM_EMAIL=onboarding@resend.dev

# ---- WhatsApp Business Cloud API (Meta) — rappels J-48h (facultatif) ----
# Envoie le rappel automatique 48h avant une formation par WhatsApp (template
# approuvé par Meta) quand le numéro du demandeur est exploitable, avec repli
# sur l'email sinon.
# Création : https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Token d'accès système + ID du numéro de téléphone (Meta → WhatsApp → API Setup).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nom du template approuvé. Contrat : 3 variables — {{1}} nom du demandeur,
# {{2}} formation, {{3}} date/heure de début de session.
WHATSAPP_TEMPLATE_NAME=rappel_formation
WHATSAPP_TEMPLATE_LANG=fr

# ---- Secret du cron de rappels automatiques J-48h (formations) ----
# L'endpoint /api/cron/reminders refuse sans cette variable (503). Vercel l'ajoute
# automatiquement au header Authorization des crons définis dans vercel.json.
# Génération :  openssl rand -hex 32
CRON_SECRET=

# ---- Domaine public des liens d'invitation (facultatif) ----
# Base des liens envoyés par email (invitation, OTP) et des liens copiés depuis
# le dashboard. Sans cette variable, on utilise https://www.lewaconsultingroup.com
# (indispensable quand on travaille en local : req.nextUrl.origin vaudrait
# http://localhost:3000, inutilisable par un collaborateur externe).
SITE_URL=
